 52348                           ;	CRC on boot output pin selection
 52349                           ;	BOOTPINSEL = RC5, CRC on boot output pin is RC5
 52350                           ;	CRC on boot output pin enable bit
 52351                           ;	BPEN = OFF, CRC on boot output pin disabled
 52352                           ;	CRC on boot output pin open drain bit
 52353                           ;	ODCON = OFF, Pin drives both high-going and low-going signals
 52354   300008                     	org	3145736
 52355   300008  FF                 	db	255
