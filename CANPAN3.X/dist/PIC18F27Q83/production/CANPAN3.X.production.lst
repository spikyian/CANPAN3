 52337                           ;	WRTC = ON, Configuration registers Write protected
 52338                           ;	Data EEPROM Write Protection bit
 52339                           ;	WRTD = OFF, Data EEPROM not Write protected
 52340                           ;	SAF Write protection bit
 52341                           ;	WRTSAF = OFF, SAF not Write Protected
 52342                           ;	Application Block write protection bit
 52343                           ;	WRTAPP = OFF, Application Block not write protected
 52344   300007                     	org	3145735
 52345   300007  FC                 	db	252
