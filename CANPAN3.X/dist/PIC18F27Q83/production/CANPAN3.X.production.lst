 51752                           
 51753                           ;Config register CONFIG1 @ 0x300000
 51754                           ;	External Oscillator Selection
 51755                           ;	FEXTOSC = HS, HS (crystal oscillator) above 8 MHz
 51756                           ;	Reset Oscillator Selection
 51757                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
 51758   300000                     	org	3145728
 51759   300000  FA                 	db	250
 51760                           
 51761                           ;Config register CONFIG2 @ 0x300001
 51762                           ;	Clock out Enable bit
 51763                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
 51764                           ;	PRLOCKED One-Way Set Enable bit
 51765                           ;	PR1WAY = ON, PRLOCKED bit can be cleared and set only once
 51766                           ;	Clock Switch Enable bit
 51767                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 51768                           ;	JTAG Enable bit
 51769                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 51770                           ;	Fail-Safe Clock Monitor Enable bit
 51771                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 51772                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 51773                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 51774                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 51775                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 51776   300001                     	org	3145729
 51777   300001  EF                 	db	239
 51778                           
 51779                           ;Config register CONFIG3 @ 0x300002
 51780                           ;	MCLR Enable bit
 51781                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 51782                           ;	Power-up timer selection bits
 51783                           ;	PWRTS = PWRT_64, PWRT set at 64ms
 51784                           ;	Multi-vector enable bit
 51785                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 51786                           ;	IVTLOCK bit One-way set enable bit
 51787                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 51788                           ;	Low Power BOR Enable bit
 51789                           ;	LPBOREN = OFF, Low-Power BOR disabled
 51790                           ;	Brown-out Reset Enable bits
 51791                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 51792   300002                     	org	3145730
 51793   300002  FD                 	db	253
 51794                           
 51795                           ;Config register CONFIG4 @ 0x300003
 51796                           ;	Brown-out Reset Voltage Selection bits
 51797                           ;	BORV = VBOR_2P7, Brown-out Reset Voltage (VBOR) set to 2.7V
 51798                           ;	ZCD Disable bit
 51799                           ;	ZCD = OFF, ZCD module is disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCD
      +                          CON
 51800                           ;	PPSLOCK bit One-Way Set Enable bit
 51801                           ;	PPS1WAY = ON, PPSLOCKED bit can be cleared and set only once; PPS registers remain loc
      +                          ked after one clear/set cycle
 51802                           ;	Stack Full/Underflow Reset Enable bit
 51803                           ;	STVREN = ON, Stack full/underflow will cause Reset
 51804                           ;	Low Voltage Programming Enable bit
 51805                           ;	LVP = ON, Low voltage programming enabled. MCLR/VPP pin function is MCLR. MCLRE config
      +                          uration bit is ignored
 51806                           ;	Extended Instruction Set Enable bit
 51807                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 51808   300003                     	org	3145731
 51809   300003  FD                 	db	253
 51810                           
 51811                           ;Config register CONFIG5 @ 0x300004
 51812                           ;	WDT Period selection bits
 51813                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
 51814                           ;	WDT operating mode
 51815                           ;	WDTE = OFF, WDT Disabled; SWDTEN is ignored
 51816   300004                     	org	3145732
 51817   300004  9F                 	db	159
 51818                           
 51819                           ;Config register CONFIG6 @ 0x300005
 51820                           ;	WDT Window Select bits
 51821                           ;	WDTCWS = WDTCWS_7, window always open (100%); software control; keyed access not requi
      +                          red
 51822                           ;	WDT input clock selector
 51823                           ;	WDTCCS = SC, Software Control
 51824   300005                     	org	3145733
 51825   300005  FF                 	db	255
 51826                           
 51827                           ;Config register CONFIG7 @ 0x300006
 51828                           ;	Boot Block Size selection bits
 51829                           ;	BBSIZE = BBSIZE_512, Boot Block size is 512 words
 51830                           ;	Boot Block enable bit
 51831                           ;	BBEN = ON, Boot block enabled
 51832                           ;	Storage Area Flash enable bit
 51833                           ;	SAFEN = OFF, SAF disabled
 51834                           ;	Background Debugger
 51835                           ;	DEBUG = 0x1, unprogrammed default
 51836   300006                     	org	3145734
 51837   300006  F7                 	db	247
 51838                           
 51839                           ;Config register CONFIG8 @ 0x300007
 51840                           ;	Boot Block Write Protection bit
 51841                           ;	WRTB = ON, Boot Block Write protected
 51842                           ;	Configuration Register Write Protection bit
 51843                           ;	WRTC = ON, Configuration registers Write protected
 51844                           ;	Data EEPROM Write Protection bit
 51845                           ;	WRTD = OFF, Data EEPROM not Write protected
 51846                           ;	SAF Write protection bit
 51847                           ;	WRTSAF = OFF, SAF not Write Protected
 51848                           ;	Application Block write protection bit
 51849                           ;	WRTAPP = OFF, Application Block not write protected
 51850   300007                     	org	3145735
 51851   300007  FC                 	db	252
 51852                           
 51853                           ;Config register CONFIG9 @ 0x300008
 51854                           ;	CRC on boot output pin selection
 51855                           ;	BOOTPINSEL = RC5, CRC on boot output pin is RC5
 51856                           ;	CRC on boot output pin enable bit
 51857                           ;	BPEN = OFF, CRC on boot output pin disabled
 51858                           ;	CRC on boot output pin open drain bit
 51859                           ;	ODCON = OFF, Pin drives both high-going and low-going signals
 51860   300008                     	org	3145736
 51861   300008  FF                 	db	255
 51862                           
 51863                           ;Config register CONFIG10 @ 0x300009
 51864                           ;	PFM and Data EEPROM Code Protection bit
 51865                           ;	CP = OFF, PFM and Data EEPROM code protection disabled
 51866   300009                     	org	3145737
 51867   300009  FF                 	db	255
 51868                           
 51869                           ;Config register CONFIG11 @ 0x30000A
 51870                           ;	CRC on boot scan enable for boot area
 51871                           ;	BOOTSCEN = OFF, CRC on boot will not include the boot area of program memory in its ca
      +                          lculation
 51872                           ;	CRC on boot Continue on Error for boot areas bit
 51873                           ;	BOOTCOE = HALT, CRC on boot will stop device if error is detected in boot areas
 51874                           ;	CRC on boot application code scan enable
 51875                           ;	APPSCEN = OFF, CRC on boot will not include the application area of program memory in 
      +                          its calculation
 51876                           ;	CRC on boot SAF area scan enable
 51877                           ;	SAFSCEN = OFF, CRC on boot will not include the SAF area of program memory in its calc
      +                          ulation
 51878                           ;	CRC on boot Data EEPROM scan enable
 51879                           ;	DATASCEN = OFF, CRC on boot will not include data EEPROM in its calculation
 51880                           ;	CRC on boot Config fuses scan enable
 51881                           ;	CFGSCEN = OFF, CRC on boot will not include the configuration fuses in its calculation
 51882                           ;	CRC on boot Continue on Error for non-boot areas bit
