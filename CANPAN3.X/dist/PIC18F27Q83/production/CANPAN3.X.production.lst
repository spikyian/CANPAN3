 52247                           ;Config register CONFIG1 @ 0x300000
 52248                           ;	External Oscillator Selection
 52249                           ;	FEXTOSC = HS, HS (crystal oscillator) above 8 MHz
 52250                           ;	Reset Oscillator Selection
 52251                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
 52252   300000                     	org	3145728
 52253   300000  FA                 	db	250
 52254                           
 52255                           ;Config register CONFIG2 @ 0x300001
 52256                           ;	Clock out Enable bit
 52257                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
 52258                           ;	PRLOCKED One-Way Set Enable bit
 52259                           ;	PR1WAY = ON, PRLOCKED bit can be cleared and set only once
 52260                           ;	Clock Switch Enable bit
 52261                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 52262                           ;	JTAG Enable bit
 52263                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 52264                           ;	Fail-Safe Clock Monitor Enable bit
 52265                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 52266                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 52267                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 52268                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 52269                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 52270   300001                     	org	3145729
 52271   300001  EF                 	db	239
 52272                           
 52273                           ;Config register CONFIG3 @ 0x300002
 52274                           ;	MCLR Enable bit
 52275                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 52276                           ;	Power-up timer selection bits
 52277                           ;	PWRTS = PWRT_64, PWRT set at 64ms
 52278                           ;	Multi-vector enable bit
 52279                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 52280                           ;	IVTLOCK bit One-way set enable bit
 52281                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 52282                           ;	Low Power BOR Enable bit
 52283                           ;	LPBOREN = OFF, Low-Power BOR disabled
 52284                           ;	Brown-out Reset Enable bits
 52285                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 52286   300002                     	org	3145730
 52287   300002  FD                 	db	253
 52288                           
 52289                           ;Config register CONFIG4 @ 0x300003
 52290                           ;	Brown-out Reset Voltage Selection bits
 52291                           ;	BORV = VBOR_2P7, Brown-out Reset Voltage (VBOR) set to 2.7V
 52292                           ;	ZCD Disable bit
 52293                           ;	ZCD = OFF, ZCD module is disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCD
      +                          CON
 52294                           ;	PPSLOCK bit One-Way Set Enable bit
 52295                           ;	PPS1WAY = ON, PPSLOCKED bit can be cleared and set only once; PPS registers remain loc
      +                          ked after one clear/set cycle
 52296                           ;	Stack Full/Underflow Reset Enable bit
 52297                           ;	STVREN = ON, Stack full/underflow will cause Reset
 52298                           ;	Low Voltage Programming Enable bit
 52299                           ;	LVP = ON, Low voltage programming enabled. MCLR/VPP pin function is MCLR. MCLRE config
      +                          uration bit is ignored
 52300                           ;	Extended Instruction Set Enable bit
 52301                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 52302   300003                     	org	3145731
 52303   300003  FD                 	db	253
 52304                           
 52305                           ;Config register CONFIG5 @ 0x300004
 52306                           ;	WDT Period selection bits
 52307                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
 52308                           ;	WDT operating mode
 52309                           ;	WDTE = OFF, WDT Disabled; SWDTEN is ignored
 52310   300004                     	org	3145732
 52311   300004  9F                 	db	159
 52312                           
 52313                           ;Config register CONFIG6 @ 0x300005
 52314                           ;	WDT Window Select bits
 52315                           ;	WDTCWS = WDTCWS_7, window always open (100%); software control; keyed access not requi
      +                          red
 52316                           ;	WDT input clock selector
 52317                           ;	WDTCCS = SC, Software Control
 52318   300005                     	org	3145733
 52319   300005  FF                 	db	255
 52320                           
 52321                           ;Config register CONFIG7 @ 0x300006
 52322                           ;	Boot Block Size selection bits
 52323                           ;	BBSIZE = BBSIZE_512, Boot Block size is 512 words
 52324                           ;	Boot Block enable bit
 52325                           ;	BBEN = ON, Boot block enabled
 52326                           ;	Storage Area Flash enable bit
 52327                           ;	SAFEN = OFF, SAF disabled
 52328                           ;	Background Debugger
 52329                           ;	DEBUG = 0x1, unprogrammed default
 52330   300006                     	org	3145734
 52331   300006  F7                 	db	247
 52332                           
 52333                           ;Config register CONFIG8 @ 0x300007
 52334                           ;	Boot Block Write Protection bit
 52335                           ;	WRTB = ON, Boot Block Write protected
